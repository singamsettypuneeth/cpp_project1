void str_rev(STRING &s1)
{
        int i,l;
        for(l=0;s1.s[l];l++);
        l--;
        for(i=0,l;i<l;i++,l--)
        {
                char t=s1.s[i];
                s1.s[i]=s1.s[l];
                s1.s[l]=t;
        }
        cout<<"string reversed:\n";
        cout<<s1.s<<endl;
}
void str_cpy(STRING &s2,STRING &s1)
{
        int i;
        for(i=0;s1.s[i];i++)
        {
                s2.s[i]=s1.s[i];
        }
        s2.s[i]='\0';
        cout<<"str_cpy:\n";
        cout<<s2.s<<endl;
}
