#include<iostream>
#include<cstring>
using namespace std;
class STRING
{
        char *s;
        int l;
        public:
        STRING()
        {
                l=0;
                s=new char[1];
                s[0]='\0';
        }
        STRING(const char *s1)
        {
                l=strlen(s1);
                s=new char[l+1];
                strcpy(s,s1);
        }
        STRING(const STRING &s1)
        {
                l=s1.l;
                s=new char[l+1];
                strcpy(s,s1.s);
        }
        ~STRING()
        {
                if(s!=0)
                        delete []s;
                        s=0;
        }
        STRING operator =(STRING s2)
        {
                if(this==&s2)
                        return *this;
                delete []s;
                l=s2.l;
                s=new char[l+1];
                strcpy(s,s2.s);
                return *this;
        }
        STRING operator +(STRING s2)
        {
                STRING temp;
                delete [] temp.s;
                temp.l=l+s2.l;
                temp.s=new char[temp.l+1];
                strcpy(temp.s,s);
                strcat(temp.s,s2.s);
                return temp;
        }
        char& operator[](int i)
        {
                cout<<"operator[]"<<endl;
                return s[i];
        }
        bool operator==(STRING s2)
        {
                return strcmp(s,s2.s)==0;
        }
        bool operator!=(STRING s2)
        {
                return strcmp(s,s2.s)!=0;
        }

        bool operator<(STRING s2)
        {
                return strcmp(s,s2.s)<0;
        }
        bool operator<=(STRING s2)
        {
                return strcmp(s,s2.s)<=0;

        }
        bool operator>(STRING s2)
        {
                return strcmp(s,s2.s)>0;
        }
        bool operator >=(STRING s2)
        {
                return strcmp(s,s2.s)>=0;

        }
        friend ostream& operator <<(ostream &,STRING &);
        friend istream& operator >>(istream &,STRING &);
        friend void str_cpy(STRING &s2,STRING &s1);
        friend void strn_cpy(STRING &s2,STRING &s1,int n);
        friend void str_rev(STRING &s1);
        friend void str_upr(STRING &s1);
        friend void str_lwr(STRING &s1);
        friend void str_chr(STRING &s1,char ch);
        friend void strr_chr(STRING &s1,char ch1);
        friend void str_str(STRING &s1,char *s3);
        friend void str_len(STRING &s1);
        friend void str_cmp(STRING &s2,STRING &s1);
        friend void strn_cmp(STRING &s2,STRING &s1,int n1);
        friend void str_cat(STRING &s2,STRING &s1);
        friend void strn_cat(STRING &s2,STRING &s1,int n2);

};
